FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY Data_Sim/ ./Data_Sim/
COPY Data/ ./Data/
COPY .env .

ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app
ENV MAIN_DATASET=Data/Datasets/main_dataset/Production_System_Dataset.csv

EXPOSE 8000

CMD ["uvicorn", "Data_Sim.streaming:app", "--host", "0.0.0.0", "--port", "8000"]