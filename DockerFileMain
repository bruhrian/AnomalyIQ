FROM python:3.11.9-slim

WORKDIR /app

RUN apt-get update && apt-get install -y \
    gcc g++ libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

ARG CACHE_BUST=1

COPY MCP_Backend/ ./MCP_Backend/
COPY Agents/ ./Agents/
COPY Frontend/ ./Frontend/
COPY Data/ ./Data/
COPY Databases_Models/ ./Databases_Models/
COPY .env .

ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app
ENV FRONTEND_DIR=/app/Frontend/html

EXPOSE 8005

CMD ["uvicorn", "MCP_Backend.main:app", "--host", "0.0.0.0", "--port", "8005"]